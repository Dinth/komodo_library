+    /// Local patch 0004: download the envelope's attachments from signal-cli
+    /// (`getAttachment`, base64) into the first message so the orchestrator's
+    /// media pipeline can transcribe audio and pass images to a vision model.
+    /// Upstream v0.8.5 always sent `attachments: vec![]`, silently dropping
+    /// photos and voice notes. Failures are logged and skipped; the text part
+    /// of the message is still delivered.
+    async fn hydrate_attachments(&self, envelope: &Envelope, messages: &mut [ChannelMessage]) {
+        const MAX_ATTACHMENT_BYTES: u64 = 20 * 1024 * 1024;
+        if self.ignore_attachments {
+            return;
+        }
+        let Some(first) = messages.first_mut() else {
+            return;
+        };
+        let Some(items) = envelope
+            .data_message
+            .as_ref()
+            .and_then(|d| d.attachments.as_ref())
+        else {
+            return;
+        };
+        for item in items {
+            let Some(id) = item.get("id").and_then(|v| v.as_str()) else {
+                continue;
+            };
+            let size = item.get("size").and_then(serde_json::Value::as_u64).unwrap_or(0);
+            if size > MAX_ATTACHMENT_BYTES {
+                ::zeroclaw_log::record!(
+                    WARN,
+                    ::zeroclaw_log::Event::new(module_path!(), ::zeroclaw_log::Action::Reject)
+                        .with_attrs(::serde_json::json!({"id": id, "size": size})),
+                    "Signal attachment too large, skipped"
+                );
+                continue;
+            }
+            let mime = item
+                .get("contentType")
+                .and_then(|v| v.as_str())
+                .map(str::to_string);
+            let data = match self
+                .rpc_request("getAttachment", serde_json::json!({ "id": id }))
+                .await
+            {
+                Ok(Some(result)) => {
+                    let b64 = result
+                        .get("data")
+                        .and_then(|v| v.as_str())
+                        .or_else(|| result.as_str())
+                        .unwrap_or_default();
+                    match base64::Engine::decode(&base64::engine::general_purpose::STANDARD, b64) {
+                        Ok(bytes) if !bytes.is_empty() => bytes,
+                        _ => continue,
+                    }
+                }
+                Ok(None) => continue,
+                Err(e) => {
+                    ::zeroclaw_log::record!(
+                        WARN,
+                        ::zeroclaw_log::Event::new(module_path!(), ::zeroclaw_log::Action::Note)
+                            .with_outcome(::zeroclaw_log::EventOutcome::Failure)
+                            .with_attrs(::serde_json::json!({"id": id, "error": format!("{e}")})),
+                        "Signal getAttachment failed"
+                    );
+                    continue;
+                }
+            };
+            // Signal voice notes are AAC; the transcription path only accepts
+            // container extensions, and ffmpeg on the whisper side probes the
+            // content anyway, so present them as .m4a.
+            let file_name = match mime.as_deref() {
+                Some("audio/aac" | "audio/mp4" | "audio/x-m4a") => format!("{id}.m4a"),
+                _ => item
+                    .get("filename")
+                    .and_then(|v| v.as_str())
+                    .filter(|f| !f.is_empty())
+                    .unwrap_or(id)
+                    .to_string(),
+            };
+            first.attachments.push(zeroclaw_api::media::MediaAttachment {
+                file_name,
+                data,
+                mime_type: mime,
+                marker: None,
+            });
+        }
+    }
