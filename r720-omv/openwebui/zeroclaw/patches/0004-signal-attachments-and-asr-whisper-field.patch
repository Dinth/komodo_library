+/// Local patch 0004: true when the endpoint path ends in `/asr`
+/// (whisper-asr-webservice), ignoring any query string.
+fn url_path_is_asr(url: &str) -> bool {
+    let path = url.split(['?', '#']).next().unwrap_or(url);
+    path.trim_end_matches('/').ends_with("/asr")
+}
